# tools/integrity.cmake — bake the SHA-256 of every DLL the launcher injects
# into gen/chain_hashes.h (consumed by apps/launcher/integrity.cpp: a DLL that
# changed after the build is never injected).
#
# Invoked from CMakeLists.txt:
#   cmake -DOUT=<header> -DFILES=<dll1>|<dll2>|... -P tools/integrity.cmake

if(NOT DEFINED OUT OR NOT DEFINED FILES)
    message(FATAL_ERROR "integrity.cmake: -DOUT=<header> and -DFILES=<dll1>|<dll2>|... are required")
endif()

string(REPLACE "|" ";" chain_files "${FILES}")

set(entries "")
set(count 0)
foreach(f IN LISTS chain_files)
    get_filename_component(name "${f}" NAME)
    file(SHA256 "${f}" hex)
    string(APPEND entries "    { L\"${name}\", \"${hex}\" },\n")
    math(EXPR count "${count} + 1")
endforeach()

file(WRITE "${OUT}"
"// Generated by tools/integrity.cmake at build time. Do not edit.\n"
"#pragma once\n"
"\n"
"struct GageChainFile { const wchar_t* name; const char* sha256; };\n"
"static const GageChainFile kGageChain[] = {\n"
"${entries}"
"};\n"
"static const int kGageChainCount = ${count};\n"
)
