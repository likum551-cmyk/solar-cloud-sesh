# Convert any binary file into a C header holding the bytes as a static array
# (the general form of tools/embed_ui.cmake, which is fixed to the launcher SPA).
#   <SYMBOL>     static const unsigned char[]
#   <SYMBOL>Len  static const unsigned long
# Usage: cmake -DINPUT=<file> -DOUTPUT=<header> -DSYMBOL=<c identifier> -P tools/embed_bytes.cmake
# Used for the overlay logo (cmake/gage_overlay.cmake).
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
  message(FATAL_ERROR "embed_bytes.cmake requires -DINPUT, -DOUTPUT and -DSYMBOL")
endif()
if(NOT SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
  message(FATAL_ERROR "embed_bytes.cmake: SYMBOL is not a C identifier: ${SYMBOL}")
endif()
if(NOT EXISTS ${INPUT})
  message(FATAL_ERROR "embed_bytes.cmake: input not found: ${INPUT}")
endif()

file(READ ${INPUT} DATA HEX)
string(LENGTH "${DATA}" hexlen)
math(EXPR nbyte "${hexlen} / 2")
if(nbyte EQUAL 0)
  message(FATAL_ERROR "embed_bytes.cmake: input is empty: ${INPUT}")
endif()

# Whole-string regex passes, not a per-byte loop (see embed_ui.cmake): 16 bytes per line.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " DATA "${DATA}")
string(REPEAT "0x[0-9a-f][0-9a-f], " 16 row)
string(REGEX REPLACE "(${row})" "\\1\n" DATA "${DATA}")
if(NOT DATA MATCHES "\n$")
  string(APPEND DATA "\n")
endif()

string(TOUPPER "${SYMBOL}" guard)
get_filename_component(inname ${INPUT} NAME)
file(WRITE ${OUTPUT}
"#ifndef GAGE_EMBED_${guard}_H\n#define GAGE_EMBED_${guard}_H\n\n// Generated by tools/embed_bytes.cmake from ${inname} - do not edit.\nstatic const unsigned char ${SYMBOL}[] = {\n${DATA}};\nstatic const unsigned long ${SYMBOL}Len = ${nbyte};\n#endif\n")

message(STATUS "Embedded ${nbyte} bytes into ${OUTPUT} as ${SYMBOL}")
