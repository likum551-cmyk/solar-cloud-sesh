#pragma once
// Generated by CMake from tools/build_config.h.in; edit the cache variables,
// not the generated copy (build/win/gen/build_config.h).

// Where the launcher reads its signed update manifest (docs/UPDATES.md). A verified
// manifest may name a newer URL (updateUrl), which the launcher then prefers; this one
// stays the fallback.
// Set at configure time: cmake -DGAGE_UPDATE_URL=<url> build/win
#define GAGE_UPDATE_URL L"@GAGE_UPDATE_URL@"

// The public key every update manifest must be signed with: base64 of the raw 64-byte
// X||Y point of an ECDSA P-256 key (tools/update-sign/keygen.mjs). Narrow ASCII.
// Set at configure time: cmake -DGAGE_UPDATE_PUBKEY=<base64> build/win
#define GAGE_UPDATE_PUBKEY "@GAGE_UPDATE_PUBKEY@"

// The platform API origin the launcher UI calls (apps/platform), no trailing
// path; an `api_base=` line in gage_mp.cfg overrides it. Empty = demo mode.
// Set at configure time: cmake -DGAGE_API_BASE=https://api.example build/win
#define GAGE_API_BASE L"@GAGE_API_BASE@"

// Testing before the platform is up: the server demo-mode PLAY joins
// (host[:port]); a `test_server=` line in gage_mp.cfg overrides it. Empty = none.
// Set at configure time: cmake -DGAGE_TEST_SERVER=host:port build/win
#define GAGE_TEST_SERVER L"@GAGE_TEST_SERVER@"
