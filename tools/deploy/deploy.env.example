# /etc/gage/deploy.env: settings of the Solar RP VPS kit (tools/deploy/*.sh). bootstrap-vps.sh copies this file there
# once and never overwrites it. Format: KEY=value, one per line, no quotes, no shell syntax. Everything is commented
# out because the defaults are the production values; uncomment a line only to change it. A variable that is already
# in the environment of the running script wins over this file.
#
# No secrets here. The signing key is a FILE under GAGE_KEY_DIR; the game server's admin token is in /etc/gage/server.env.

# --- network identity -------------------------------------------------------------------------------------------
# The VPS's public IPv4 (the plain-HTTP fallback address of the update feed).
#PUBLIC_IP=5.175.253.187
# The public host name. DNS A records for the apex and www point at PUBLIC_IP. An EMPTY value means IP-only operation over
# plain HTTP (launchers then need the IP URL baked in); never leave "DOMAIN=" empty by accident.
#DOMAIN=solar-rp.com

# --- update feed ------------------------------------------------------------------------------------------------
# URL prefix of the installer inside the signed manifest. Default: https://$DOMAIN/update (http://$PUBLIC_IP/update without a domain).
#UPDATE_BASE_URL=https://solar-rp.com/update
# The manifest URL baked into every NEW launcher build (build-client.sh passes it as -DGAGE_UPDATE_URL).
#BAKED_MANIFEST_URL=https://solar-rp.com/update/version.json
# Optional signed `updateUrl` that moves already-installed launchers to another manifest URL. Normally empty:
# launchers from 0.4.0 on already bake the https URL, and 0.3.x launchers have no updater at all.
#SIGNED_UPDATE_URL=

# --- player-facing file names (the Solar RP rename) -------------------------------------------------------------
#CLIENT_EXE=SolarLauncher.exe
#INSTALLER_PREFIX=SolarRP-Setup

# --- game server ------------------------------------------------------------------------------------------------
# The "name" deploy-server.sh writes into /opt/gage/server/server.json when it first seeds that file (the launcher's list
# shows it). Solar RP's servers are LUNA, TERRA and SOL; this VPS runs SOL. An existing server.json is never rewritten.
#SERVER_NAME=SOL

# --- paths --------------------------------------------------------------------------------------------------------
#GAGE_OPT=/opt/gage
#GAGE_KEY_DIR=/root/.gage-keys
#GAGE_WEB_ROOT=/var/www/gage

# --- optional client build settings ---------------------------------------------------------------------------------
# Platform API origin for the launcher UI (empty = the UI shows its labelled demo data) and a test server for demo-mode PLAY.
# At least one must be set, or the launcher refuses every PLAY (code 13) and build-client.sh refuses to build. Until
# apps/platform runs, PLAY reaches SOL (this VPS) as the test server.
#GAGE_API_BASE=
GAGE_TEST_SERVER=5.175.253.187:24800
