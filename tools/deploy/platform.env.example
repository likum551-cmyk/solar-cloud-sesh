# Solar RP platform API settings: the template of /opt/gage/platform.env on the VPS (owner gage-platform, mode 0600).
# tools/deploy/deploy-platform.sh writes that file ONCE, from the values below, with a fresh random database password and
# webhook secret; after that it never changes an existing value and only appends the non-secret keys that are missing
# (it names each one). Edit the live file by hand, then: systemctl restart gage-platform
#
# Format: KEY=value, one per line, no `export`, no shell syntax (systemd's EnvironmentFile= and node --env-file both
# read it). Every variable and its default: apps/platform/docs/api.md, "Environment variables".
# CHANGE_ME marks the two secrets the script generates; this template holds no real secret.

# --- required in production ---------------------------------------------------------------------------------------
NODE_ENV=production
# PostgreSQL on this host (deploy-platform.sh creates the role and the database). The password is 48 hex characters,
# so it needs no URL escaping.
DATABASE_URL=postgres://gage_platform:CHANGE_ME@127.0.0.1:5432/gage_platform
# Same origin as the website: Caddy proxies https://solar-rp.com/api/* to 127.0.0.1:8787 with /api stripped. Used for
# the OpenAPI server URL, checkout URLs and the Discord redirect (<PUBLIC_API_URL>/v1/auth/discord/callback).
PUBLIC_API_URL=https://solar-rp.com/api

# --- network ------------------------------------------------------------------------------------------------------
# Both listeners stay on loopback. 8787 is proxied by Caddy; 8788 (/internal/*, the game servers) is never proxied.
HOST=127.0.0.1
PORT=8787
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=8788
# Caddy is the one proxy in front (on 127.0.0.1) and replaces any client-sent X-Forwarded-For: the client address is
# its last entry. Only safe while HOST is loopback (deploy-platform.sh refuses TRUST_PROXY=1 with any other HOST).
TRUST_PROXY=1
# The launcher's WebView2 origin. The website needs no entry: it calls /api on its own origin.
CORS_ORIGINS=https://app.gage

# --- accounts -----------------------------------------------------------------------------------------------------
# Mail: the outbox driver delivers nothing (it stores mail in the database with the tokens redacted), so with it no one
# can verify an email or reset a password, and joining and buying must not require a verified email.
# Real delivery = Resend: verify solar-rp.com in Resend (its DNS records), create an API key with sending access,
# then edit this file by hand (deploys never change a value here) and set
#   EMAIL_DRIVER=resend
#   RESEND_API_KEY=re_...            (the platform refuses to start without it; never logged)
#   REQUIRE_VERIFIED_EMAIL=1         (joining a server and buying then need a verified email; logging in never does)
# and restart: systemctl restart gage-platform. The startup log has no "does not deliver mail" warning once it works.
EMAIL_DRIVER=outbox
REQUIRE_VERIFIED_EMAIL=0
EMAIL_FROM="Solar RP <no-reply@solar-rp.com>"
EMAIL_LINK_BASE_URL=gage-mp://auth
# Discord login and linking stay off until both are set. In the Discord developer portal (OAuth2), add the redirect
# <PUBLIC_API_URL>/v1/auth/discord/callback, i.e. https://solar-rp.com/api/v1/auth/discord/callback (scopes: identify email).
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
# The website's origin: a Discord link started on the website returns to <SITE_ORIGIN>/account/ (never taken from a
# request). https only in production; no path.
SITE_ORIGIN=https://solar-rp.com

# --- shop ---------------------------------------------------------------------------------------------------------
# The only payment provider that exists is the fake one, and production refuses to START without one of these two
# lines. With a random secret that never leaves this file nobody can sign a payment, and /v1/dev/* is not mounted in
# production, so an order can be created but never paid: the shop is closed in practice. Replace all three when a
# real PaymentProvider is registered in buildDeps().
PAYMENT_PROVIDER=fake
ALLOW_FAKE_PAYMENTS_IN_PRODUCTION=1
FAKE_WEBHOOK_SECRET=CHANGE_ME_at_least_16_chars
# Never ENABLE_DEV_ROUTES=1 here (startup refuses it in production).

# --- operations ---------------------------------------------------------------------------------------------------
LOG_LEVEL=info
SHUTDOWN_GRACE_SECONDS=10
