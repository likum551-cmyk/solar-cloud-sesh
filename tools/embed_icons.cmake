# Embed every PNG in a folder into ONE C header as a name -> bytes table (0.6 inventory icons: GI's REV3 design set,
# brand/icons/inventory/*.png, 96 x 96 white glyphs, tinted at draw time). The general one-file form is tools/embed_bytes.cmake.
#   struct GageIcon { const char* name; const unsigned char* data; unsigned long len; };
#   static const GageIcon <SYMBOL>[] (sorted by name), static const int <SYMBOL>Count
# Usage: cmake -DINPUT_DIR=<folder> -DOUTPUT=<header> -DSYMBOL=<c identifier> -P tools/embed_icons.cmake
if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
  message(FATAL_ERROR "embed_icons.cmake requires -DINPUT_DIR, -DOUTPUT and -DSYMBOL")
endif()
if(NOT SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
  message(FATAL_ERROR "embed_icons.cmake: SYMBOL is not a C identifier: ${SYMBOL}")
endif()
file(GLOB pngs LIST_DIRECTORIES false "${INPUT_DIR}/*.png")
list(SORT pngs)
list(LENGTH pngs count)
if(count EQUAL 0)
  message(FATAL_ERROR "embed_icons.cmake: no .png in ${INPUT_DIR}")
endif()

string(TOUPPER "${SYMBOL}" guard)
set(body "")
set(table "")
set(i 0)
string(REPEAT "0x[0-9a-f][0-9a-f], " 16 row)
foreach(png IN LISTS pngs)
  get_filename_component(name ${png} NAME_WE)
  if(NOT name MATCHES "^[a-z0-9_]+$")
    message(FATAL_ERROR "embed_icons.cmake: icon name is not [a-z0-9_]: ${name}")
  endif()
  file(READ ${png} DATA HEX)
  string(LENGTH "${DATA}" hexlen)
  math(EXPR nbyte "${hexlen} / 2")
  if(nbyte EQUAL 0)
    message(FATAL_ERROR "embed_icons.cmake: empty icon: ${png}")
  endif()
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " DATA "${DATA}")
  string(REGEX REPLACE "(${row})" "\\1\n" DATA "${DATA}")
  string(APPEND body "static const unsigned char ${SYMBOL}_${i}[] = {\n${DATA}\n};\n")
  string(APPEND table "    {\"${name}\", ${SYMBOL}_${i}, ${nbyte}ul},\n")
  math(EXPR i "${i} + 1")
endforeach()

file(WRITE ${OUTPUT}
"#ifndef GAGE_EMBED_${guard}_H\n#define GAGE_EMBED_${guard}_H\n\n// Generated by tools/embed_icons.cmake from ${INPUT_DIR} - do not edit.\n#ifndef GAGE_ICON_STRUCT\n#define GAGE_ICON_STRUCT\nstruct GageIcon { const char* name; const unsigned char* data; unsigned long len; };\n#endif\n${body}static const GageIcon ${SYMBOL}[] = {\n${table}};\nstatic const int ${SYMBOL}Count = ${count};\n#endif\n")
message(STATUS "Embedded ${count} icons into ${OUTPUT} as ${SYMBOL}")
