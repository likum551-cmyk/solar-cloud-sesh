+/*
+** GAGE patch (third_party/lua/GAGE-PATCHES.md): a CPU budget for pattern
+** matching. The instruction-count hook cannot interrupt a C function, and
+** Lua patterns backtrack (".-.-.-b" on a long string is O(n^3)), so without
+** this a script could freeze the server inside string.find. Compiled in only
+** when GAGE_LUA_PATTERN_BUDGET is defined; without it this file behaves
+** exactly like upstream. The host arms 'gage_lua_pattern_steps_left' (declared
+** extern "C" in libs/scripting) before it runs script code; every step of
+** the matcher (one match() entry or loop turn) costs one unit, and an
+** exhausted budget raises a normal Lua error. Single-threaded by design.
+*/
+#if defined(GAGE_LUA_PATTERN_BUDGET)
+unsigned long gage_lua_pattern_steps_left = ~0UL;
+#define GAGE_CHARGE(ms) \
+  do { \
+    if (l_unlikely(gage_lua_pattern_steps_left == 0)) \
+      luaL_error((ms)->L, "pattern matching budget exceeded"); \
+    gage_lua_pattern_steps_left--; \
+  } while (0)
+#else
+#define GAGE_CHARGE(ms) ((void)0)
+#endif
+
