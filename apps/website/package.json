{
  "name": "solar-rp-website",
  "version": "0.1.0",
  "private": true,
  "description": "solar-rp.com: the public Solar RP landing page. Static files served by Caddy from /var/www/gage/site.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "media": "node scripts/media.mjs",
    "dev": "node scripts/media.mjs && vite",
    "build": "node scripts/media.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.173.0"
  },
  "devDependencies": {
    "@types/three": "0.173.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
